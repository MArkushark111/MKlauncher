#!/bin/bash

# MKGames CLI Management Tool
# Usage: mkgames <command>

VERSION="1.0.0"
SERVER_BIN="/opt/mkgames/mkgames-server"
SERVICE_NAME="mkgames"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'
BOLD='\033[1m'

print_header() {
    echo ""
    echo -e "${GREEN}╔══════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║     MKGAMES CLI  v${VERSION}              ║${NC}"
    echo -e "${GREEN}╚══════════════════════════════════════╝${NC}"
    echo ""
}

print_usage() {
    print_header
    echo -e "  ${BOLD}Usage:${NC} mkgames <command>"
    echo ""
    echo -e "  ${BOLD}Commands:${NC}"
    echo -e "  ${CYAN}start${NC}              Start the server"
    echo -e "  ${CYAN}stop${NC}               Stop the server"
    echo -e "  ${CYAN}restart${NC}            Restart the server"
    echo -e "  ${CYAN}status${NC}             Show server status"
    echo -e "  ${CYAN}wan${NC}                Display WAN:PORT"
    echo -e "  ${CYAN}logs${NC}               Show live server logs"
    echo -e "  ${CYAN}add-admin${NC}          Add a new admin"
    echo -e "  ${CYAN}remove-admin${NC}       Remove an admin"
    echo -e "  ${CYAN}list-games${NC}         List all games"
    echo -e "  ${CYAN}list-admins${NC}        List all admins"
    echo -e "  ${CYAN}install-service${NC}    Install systemd service"
    echo -e "  ${CYAN}uninstall-service${NC}  Remove systemd service"
    echo -e "  ${CYAN}help${NC}               Show this help"
    echo ""
}

cmd_start() {
    echo -e "${CYAN}[*] Starting MKGames Server...${NC}"
    systemctl start $SERVICE_NAME 2>/dev/null
    if [[ $? -eq 0 ]]; then
        echo -e "${GREEN}[+] Server started${NC}"
    else
        echo -e "${RED}[!] Failed to start server${NC}"
        echo -e "${YELLOW}Try: systemctl status $SERVICE_NAME${NC}"
    fi
}

cmd_stop() {
    echo -e "${CYAN}[*] Stopping MKGames Server...${NC}"
    systemctl stop $SERVICE_NAME 2>/dev/null
    echo -e "${GREEN}[+] Server stopped${NC}"
}

cmd_restart() {
    echo -e "${CYAN}[*] Restarting MKGames Server...${NC}"
    systemctl restart $SERVICE_NAME 2>/dev/null
    if [[ $? -eq 0 ]]; then
        echo -e "${GREEN}[+] Server restarted${NC}"
    else
        echo -e "${RED}[!] Failed to restart${NC}"
    fi
}

cmd_status() {
    echo -e "${BOLD}Server Status:${NC}"
    echo ""

    systemctl is-active $SERVICE_NAME &>/dev/null
    if [[ $? -eq 0 ]]; then
        echo -e "  Status:     ${GREEN}RUNNING${NC}"
        PID=$(systemctl show -p MainPID $SERVICE_NAME --value 2>/dev/null)
        echo -e "  PID:        ${CYAN}${PID}${NC}"
        UPTIME=$(systemctl show -p ActiveEnterTimestamp $SERVICE_NAME --value 2>/dev/null)
        echo -e "  Since:      ${DIM}${UPTIME}${NC}"
    else
        echo -e "  Status:     ${RED}STOPPED${NC}"
    fi

    echo ""

    HEALTH=$(curl -s http://localhost:8080/api/health 2>/dev/null)
    if [[ -n "$HEALTH" ]]; then
        echo -e "  ${BOLD}Health:${NC}"
        echo "$HEALTH" | grep -o '"[^"]*":[^,}]*' | while read line; do
            KEY=$(echo "$line" | cut -d'"' -f2)
            VAL=$(echo "$line" | cut -d':' -f2- | tr -d '"')
            echo -e "    ${CYAN}${KEY}${NC}: ${VAL}"
        done
    fi
    echo ""
}

cmd_wan() {
    DB_FILE="/var/lib/mkgames/mkgames.db"

    if [[ ! -f "$DB_FILE" ]]; then
        echo -e "${RED}[!] Database not found. Is the server installed?${NC}"
        return
    fi

    WAN_INFO=$(sqlite3 "$DB_FILE" "SELECT wan_host || ':' || wan_port FROM server_config WHERE id=1;" 2>/dev/null)

    if [[ -z "$WAN_INFO" || "$WAN_INFO" == ":" || "$WAN_INFO" == ":8080" ]]; then
        echo -e "${YELLOW}[!] WAN not configured yet${NC}"
        echo -e "${CYAN}Configure via admin panel or run: mkgames config${NC}"
        return
    fi

    echo -e "${GREEN}WAN: ${BOLD}${WAN_INFO}${NC}"
}

cmd_logs() {
    LOG_FILE="/var/log/mkgames/server.log"
    if [[ ! -f "$LOG_FILE" ]]; then
        echo -e "${RED}[!] Log file not found${NC}"
        return
    fi
    echo -e "${CYAN}Showing live logs (Ctrl+C to exit)...${NC}"
    echo ""
    tail -f "$LOG_FILE"
}

cmd_add_admin() {
    if [[ $# -lt 2 ]]; then
        echo -e "${RED}Usage: mkgames add-admin <username> <passcode>${NC}"
        return
    fi

    DB_FILE="/var/lib/mkgames/mkgames.db"
    HASH=$(echo -n "mkgames_salt_$2" | sha256sum | cut -d' ' -f1)

    sqlite3 "$DB_FILE" "INSERT OR IGNORE INTO admins (username, passcode_hash) VALUES ('$1', '$HASH');" 2>/dev/null

    if [[ $? -eq 0 ]]; then
        echo -e "${GREEN}[+] Admin '$1' added${NC}"
    else
        echo -e "${RED}[!] Failed to add admin${NC}"
    fi
}

cmd_remove_admin() {
    if [[ $# -lt 1 ]]; then
        echo -e "${RED}Usage: mkgames remove-admin <username>${NC}"
        return
    fi

    DB_FILE="/var/lib/mkgames/mkgames.db"
    sqlite3 "$DB_FILE" "DELETE FROM admins WHERE username='$1';" 2>/dev/null
    echo -e "${GREEN}[+] Admin '$1' removed${NC}"
}

cmd_list_games() {
    DB_FILE="/var/lib/mkgames/mkgames.db"

    if [[ ! -f "$DB_FILE" ]]; then
        echo -e "${RED}[!] Database not found${NC}"
        return
    fi

    echo -e "${BOLD}Games:${NC}"
    echo ""
    printf "  ${CYAN}%-4s %-30s %-10s %-10s${NC}\n" "ID" "NAME" "VERSION" "DOWNLOADS"
    echo "  ─────────────────────────────────────────────────────────"

    sqlite3 "$DB_FILE" "SELECT id, name, version, download_count FROM games ORDER BY name;" 2>/dev/null | while IFS='|' read id name ver dl; do
        printf "  %-4s %-30s %-10s %-10s\n" "$id" "$name" "$ver" "$dl"
    done
    echo ""
}

cmd_list_admins() {
    DB_FILE="/var/lib/mkgames/mkgames.db"

    echo -e "${BOLD}Admins:${NC}"
    echo ""
    printf "  ${CYAN}%-20s %-30s${NC}\n" "USERNAME" "CREATED"
    echo "  ─────────────────────────────────────────────────────────"

    sqlite3 "$DB_FILE" "SELECT username, created_at FROM admins ORDER BY created_at;" 2>/dev/null | while IFS='|' read user created; do
        printf "  %-20s %-30s\n" "$user" "$created"
    done
    echo ""
}

cmd_install_service() {
    echo -e "${CYAN}[*] Installing systemd service...${NC}"

    cat > /etc/systemd/system/$SERVICE_NAME.service << EOF
[Unit]
Description=MKGames Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mkgames
ExecStart=/opt/mkgames/mkgames-server
Restart=always
RestartSec=5
StandardOutput=append:/var/log/mkgames/server.log
StandardError=append:/var/log/mkgames/server.log

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable $SERVICE_NAME
    echo -e "${GREEN}[+] Service installed and enabled${NC}"
}

cmd_uninstall_service() {
    echo -e "${CYAN}[*] Removing service...${NC}"
    systemctl stop $SERVICE_NAME 2>/dev/null
    systemctl disable $SERVICE_NAME 2>/dev/null
    rm -f /etc/systemd/system/$SERVICE_NAME.service
    systemctl daemon-reload
    echo -e "${GREEN}[+] Service removed${NC}"
}

case "$1" in
    start)            cmd_start ;;
    stop)             cmd_stop ;;
    restart)          cmd_restart ;;
    status)           cmd_status ;;
    wan)              cmd_wan ;;
    logs)             cmd_logs ;;
    add-admin)        shift; cmd_add_admin "$@" ;;
    remove-admin)     shift; cmd_remove_admin "$@" ;;
    list-games)       cmd_list_games ;;
    list-admins)      cmd_list_admins ;;
    install-service)  cmd_install_service ;;
    uninstall-service) cmd_uninstall_service ;;
    help|--help|-h)   print_usage ;;
    *)                print_usage ;;
esac
